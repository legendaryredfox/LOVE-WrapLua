    "tests",
    "game",
    "tools",
    "docs",
    "LOVE-WrapLua/vendor"
  ],
  "diagnostics.globals": [
    "lv1lua",
    "lv1luaconf",
    "System",
    "image",
    "Graphics",
    "Sound",
    "Font",
    "screen",
    "pad",
    "Timer",
    "files",
    "Controls",
    "color",
    "Keyboard",
    "sound",
    "snd",
    "draw",
    "Color",
    "Screen",
    "sys",
    "font",
    "touch",
    "timer",
    "osk",
    "gfx",
    "buttons",
    "FCREATE",
    "FWRITE",
    "FREAD",
    "TOP_SCREEN",
    "BOTTOM_SCREEN",
    "EndGFX",
    "StartGFX",
    "InitGFX",
    "FlipGFX",
    "InitFont",
    "DrawText",
    "SCE_CTRL_CIRCLE",
    "g_status",
    "FINISHED",
    "PRESSED",
    "CLEANED",
    "NOT_PRESSED",
    "__IMG_FILTER_POINT",
    "__IMG_FILTER_LINEAR",
    "KEY_A",
    "KEY_B",
