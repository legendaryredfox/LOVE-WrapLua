diff -ruN lua-5.1.5/src/lmathlib.c lua-5.1.5-psp/src/lmathlib.c
--- lua-5.1.5/src/lmathlib.c	2007-12-27 11:02:25.000000000 -0200
+++ lua-5.1.5-psp/src/lmathlib.c	2026-11-17 09:50:00.359721978 -0300
@@ -17,6 +17,31 @@
 #include "lualib.h"
 
 
+#ifdef PSP_LUA_FLOAT
+/* Lua numbers are float: use the single-precision libm (hardware FPU) instead of
+   the double versions, which run in software on the Allegrex. */
+#include <pspmath.h>
+#define sin vfpu_sinf
+#define sinh sinhf
+#define cos vfpu_cosf
+#define cosh coshf
+#define tan tanf
+#define tanh tanhf
+#define asin asinf
+#define acos acosf
+#define atan atanf
+#define atan2 atan2f
+#define floor floorf
+#define ceil ceilf
+#define fmod fmodf
+#define sqrt sqrtf
+#define pow powf
+#define log logf
+#define log10 log10f
+#define exp expf
+#define fabs fabsf
+#endif
+
 #undef PI
 #define PI (3.14159265358979323846)
 #define RADIANS_PER_DEGREE (PI/180.0)
